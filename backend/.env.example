ENV=development
DEBUG=True

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih_monitoring

SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Optional: AI inspection-report photo analysis -----------------
# Leave all three unset to run photo analysis fully offline (OpenCV
# heuristics + caption/text keyword theme matching). Set any one to
# upgrade to real vision-model theme detection + scoring for photos --
# the service tries them in order and falls back automatically.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
